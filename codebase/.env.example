# Copy to .env (compose) and to each service's own .env. NEVER commit real values.
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me

# --- shared by every service that verifies JWT (must be identical) ---
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
JWT_EXPIRY_TIME=30

# --- Kafka (inside docker network) ---
BOOTSTRAP_SERVER=broker:19092
# User service uses KAFKA_SERVER instead of BOOTSTRAP_SERVER
KAFKA_SERVER=broker:19092

# --- Payment service ---
STRIPE_API_KEY=sk_test_xxx
STRIPE_SUCCESS_URL=http://localhost:8000/payment-service/success
STRIPE_CANCEL_URL=http://localhost:8000/payment-service/cancel

# --- Notification service ---
FROM_EMAIL=you@example.com
FROM_EMAIL_APP_PASSWORD=app-password

# --- Topics: the SAME value must be used on the producer and the consumer side ---
# Example values (one line per flow, `=` shows which variables must be equal):
#
# user commands (Order/Payment -> User):
#   user:         KAFKA_TOPIC_USER = user-requests
#   order+payment KAFKA_TOPIC_REQUEST_TO_USER = user-requests
# user replies:
#   user+order:   KAFKA_TOPIC_RESPONSE_FROM_USER_TO_ORDER = user-to-order
#   user+payment: KAFKA_TOPIC_RESPONSE_FROM_USER_TO_PAYMENT = user-to-payment
# new user event (User -> Notification):
#   user:         KAFKA_TOPIC_USER_REGISTERED = user-registered
#   notification: KAFKA_TOPIC_TO_CONSUME_NEW_USER = user-registered
# order commands (API of Order -> consumer of Order):
#   order:        KAFKA_TOPIC_ORDER = orders
# order events, published AFTER an order is accepted/deleted (Order -> Payment, Notification):
#   order:        KAFKA_TOPIC_ORDER_EVENTS = order-events
#   payment:      KAFKA_TOPIC_GET_FROM_ORDER = order-events
#   notification: KAFKA_TOPIC_TO_CONSUME_ORDER_CREATED = order-events
# payment result (Payment -> Order, Notification):
#   payment:      KAFKA_TOPIC_PAYMENT = payment-done
#   order:        KAFKA_TOPIC_PAYMENT_DONE_FROM_PAYMENT = payment-done
#   notification: KAFKA_TOPIC_TO_CONSUME_PAYMENT_DONE = payment-done
# inventory check, request / reply (Order <-> Inventory):
#   order+inventory: KAFKA_TOPIC_INVENTORY_CHECK_REQUEST = inventory-check-request
#   order+inventory: KAFKA_TOPIC_INVENTORY_CHECK_RESPONSE = inventory-check-response
# product events (Product -> Inventory):
#   product:      KAFKA_TOPIC_PRODUCT = products
#   inventory:    KAFKA_TOPIC_GET_PRODUCT = products
# stock level (Inventory -> Product):
#   inventory+product: KAFKA_TOPIC_STOCK_LEVEL_CHECK = stock-level
#
# Each consumer needs its own KAFKA_CONSUMER_GROUP_ID_* (distinct values per service).
